{
  "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {},
  "variables": {},
  "resources": [
    {
      "name": "pl_incremental_ingestion",
      "type": "pipelines",
      "apiVersion": "2018-06-01",
      "properties": {
        "activities": [
          {
            "name": "NB_Incremental_bronze",
            "type": "TridentNotebook",
            "dependsOn": [],
            "policy": {
              "timeout": "0.12:00:00",
              "retry": 0,
              "retryIntervalInSeconds": 30,
              "secureOutput": false,
              "secureInput": false
            },
            "typeProperties": {
              "notebookId": "REPLACE_WITH_NB_INCREMENTAL_BRONZE_NOTEBOOK_ID",
              "workspaceId": "REPLACE_WITH_FABRIC_WORKSPACE_ID",
              "sessionTag": "fabric_etl_session"
            }
          },
          {
            "name": "NB_Incremental_Silver",
            "type": "TridentNotebook",
            "dependsOn": [
              {
                "activity": "NB_Incremental_bronze",
                "dependencyConditions": [
                  "Succeeded"
                ]
              }
            ],
            "policy": {
              "timeout": "0.12:00:00",
              "retry": 0,
              "retryIntervalInSeconds": 30,
              "secureOutput": false,
              "secureInput": false
            },
            "typeProperties": {
              "notebookId": "REPLACE_WITH_NB_INCREMENTAL_SILVER_NOTEBOOK_ID",
              "workspaceId": "REPLACE_WITH_FABRIC_WORKSPACE_ID",
              "sessionTag": "fabric_etl_session"
            }
          },
          {
            "name": "NB_Incremental_Gold",
            "type": "TridentNotebook",
            "dependsOn": [
              {
                "activity": "NB_Incremental_Silver",
                "dependencyConditions": [
                  "Succeeded"
                ]
              }
            ],
            "policy": {
              "timeout": "0.12:00:00",
              "retry": 0,
              "retryIntervalInSeconds": 30,
              "secureOutput": false,
              "secureInput": false
            },
            "typeProperties": {
              "notebookId": "REPLACE_WITH_NB_INCREMENTAL_GOLD_NOTEBOOK_ID",
              "workspaceId": "REPLACE_WITH_FABRIC_WORKSPACE_ID",
              "sessionTag": "fabric_etl_session"
            }
          }
        ]
      },
      "dependsOn": []
    }
  ]
}
